# ==========================================
# HydraLite Configuration Template
# ==========================================

# Network Configuration
# Use 'mainnet' for production, 'preprod' or 'preview' for testing
CARDANO_NETWORK=preprod

# Security
# Comma-separated list of allowed frontend origins
# Example: https://my-project.vercel.app,https://my-dashboard.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Hydra Node Endpoints
HYDRA_API_URL=http://localhost:4001
HYDRA_WS_URL=ws://localhost:4001

# Ogmios Node Endpoints
OGMIOS_WS_URL=ws://localhost:1337

# Application Settings
LOG_LEVEL=INFO
ENABLE_AUTO_SCALER=false

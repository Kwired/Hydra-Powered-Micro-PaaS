# ==========================================
# HydraLite Configuration Template (v1.0.0 Mainnet)
# ==========================================

# Network Configuration
# This must be 'mainnet' for production deployments.
CARDANO_NETWORK=mainnet

# Security
# Comma-separated list of allowed frontend origins that can interact with this API.
# Deployers must change this to their specific dashboard/application domains.
# Example: https://my-project.vercel.app,https://my-dashboard.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Hydra Node Endpoints
HYDRA_API_URL=http://hydra-node:4001
HYDRA_WS_URL=ws://hydra-node:4001

# Ogmios Node Endpoints
OGMIOS_WS_URL=ws://ogmios:1337

# Application Settings
LOG_LEVEL=INFO
ENABLE_AUTO_SCALER=true
